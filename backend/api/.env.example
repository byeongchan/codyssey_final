# Spring Boot does not load this file. Set these as PowerShell environment variables.
APP_ENV=development
DATA_PROVIDER=reef-danawa
# Inactive legacy adapter: live mode does not load fixture files. Keep this value.
CATALOG_SOURCE=fixture
AI_URL=http://127.0.0.1:8000
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
COLLECTOR_URL=http://127.0.0.1:4001
INTERNAL_API_KEY=
FIREBASE_MODE=cloud
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
OPERATIONS_UIDS=
ALERT_SCHEDULER_ENABLED=false
SNAPSHOT_ALERT_EVENTS_ENABLED=false
# Remove FIREBASE_AUTH_EMULATOR_HOST and FIRESTORE_EMULATOR_HOST in cloud mode.
# Shared live display cache TTL (seconds)
LIVE_SEARCH_CACHE_SECONDS=900
LIVE_PRODUCT_CACHE_SECONDS=21600
LIVE_OFFERS_CACHE_SECONDS=300
# Optional paid recurring collection: disabled unless deliberately enabled.
LIVE_REFRESH_ENABLED=false
LIVE_REFRESH_MILLIS=21600000
