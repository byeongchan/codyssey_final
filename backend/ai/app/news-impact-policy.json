  "productMappings": {},
  "signals": {
    "upward": [
      {
        "id": "supply_shortage",
        "pattern": "공급\\s*(?:부족|감소|차질)|생산\\s*(?:차질|중단|감소)|감산|출하량\\s*감소|수확량\\s*감소|흉작",
        "path": "기사에 기술된 공급 감소 요인 → 해당 상품군의 공급 제약 → 판매가 상승 압력 가능성"
      },
      {
        "id": "cost_increase",
        "pattern": "(?:가격|원가|단가|물류비|운송비|관세).{0,16}(?:상승|인상|급등)|(?:가격|원가|단가)가?\\s*올랐",
        "path": "기사에 기술된 비용·가격 상승 요인 → 상품 원가·유통 비용 전가 가능성 → 판매가 상승 압력 가능성"
      },
      {
        "id": "demand_increase",
        "pattern": "수요\\s*(?:급증|폭증|증가)|재고\\s*(?:부족|소진)",
        "path": "기사에 기술된 수요 증가·재고 감소 → 수급 긴축 가능성 → 판매가 상승 압력 가능성"
      }
    ],
    "downward": [
      {
        "id": "inventory",
        "pattern": "재고\\s*(?:증가|누적|과잉)|공급(?:량)?\\s*(?:과잉|증가|확대)|생산량\\s*(?:증가|확대)|출하량\\s*증가|수요\\s*(?:감소|위축)|가격\\s*경쟁\\s*(?:심화|확대)",
        "path": "기사에 기술된 재고·경쟁 요인 → 판매 촉진·가격 경쟁 가능성 → 판매가 하락 압력 가능성"
      },
      {
        "id": "price_cut",
        "pattern": "(?:가격|판매가|출고가|원가|단가).{0,16}(?:인하|하락|급락)|할인\\s*(?:확대|행사|판매|율)|특가|쿠폰",
        "path": "기사에 기술된 인하·할인 요인 → 해당 상품군의 실판매가 하락 압력 가능성; 개별 적용 조건은 미확인"
      },
      {
        "id": "resolved",
        "pattern": "(?:공급|생산).{0,14}(?:정상화|재개)|(?:부족|차질).{0,10}해소",
        "path": "기사에 기술된 공급·생산 회복 → 기존 공급 제약 완화 가능성 → 가격 상승 압력 완화 가능성"
      }
    ],
    "policy": "관세|수출\\s*(?:규제|제한|통제)|수입\\s*규제|보조금|수입\\s*금지",
    "speculative": "가능성|전망|예상|우려|검토|논의|추진|할\\s*수\\s*있",
    "negation": "아니|않(?:았|는|다|고)|없(?:었|는|다)|부인|사실무근|반박",
    "competition": "경쟁|신제품|신형|출시"
  }
}
