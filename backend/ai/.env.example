APP_ENV=development
AI_PROVIDER=gemini
# gemini 선택 시 필요. 실제 키는 이 파일에 기록하지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NEWS_PROVIDER=naver
# NAVER API HUB에서 발급한 Client ID / Client Secret을 사용합니다.
# 네이버 개발자 센터의 기존 검색 Open API 키와 구분하세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NEWS_PROVIDER=rss 선택 시에만 아래 RSS 설정을 사용합니다.
RSS_FEEDS_JSON=[{"name":"연합뉴스","url":"https://www.yna.co.kr/rss/news.xml"}]
RSS_ALLOWED_HOSTS=www.yna.co.kr,yna.co.kr
INTERNAL_API_KEY=